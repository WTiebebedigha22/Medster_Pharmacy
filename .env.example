# ============================================
# Medster Pharmacy - Environment Variables
# ============================================
# Copy this file to .env and fill in your values

# ---- Server ----
PORT=4000
NODE_ENV=development

# ---- Supabase (Database) ----
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- iRECPlus API ----
IREC_API_URL=https://api.irec.com/v1
IREC_API_KEY=your-irec-api-key
IREC_API_TIMEOUT=30000
IREC_SYNC_INTERVAL=*/30 * * * *

# ---- JWT (Custom Auth) ----
JWT_SECRET=your-jwt-secret-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ---- Paystack (Payment Gateway) ----
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxx
VITE_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxx
PAYSTACK_CALLBACK_URL=http://localhost:5173/checkout/verify
PAYSTACK_WEBHOOK_SECRET=your-webhook-secret

# ---- Cloudinary (Prescription Storage) ----
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ---- CORS ----
CORS_ORIGIN=http://localhost:5173
